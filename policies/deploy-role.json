{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "lambda.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "s3.amazonaws.com"
          ]
        }
      }
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfileTags",
        "iam:ListInstanceProfilesForRole",
        "iam:ListMFADeviceTags",
        "iam:ListOpenIDConnectProviderTags",
        "iam:ListPolicyTags",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:ListSAMLProviderTags",
        "iam:ListServerCertificateTags",
        "iam:ListUserTags",
        "iam:PutRolePolicy",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:TagMFADevice",
        "iam:TagOpenIDConnectProvider",
        "iam:TagPolicy",
        "iam:TagRole",
        "iam:TagSAMLProvider",
        "iam:TagServerCertificate",
        "iam:TagUser",
        "iam:UntagInstanceProfile",
        "iam:UntagMFADevice",
        "iam:UntagOpenIDConnectProvider",
        "iam:UntagPolicy",
        "iam:UntagRole",
        "iam:UntagSAMLProvider",
        "iam:UntagServerCertificate",
        "iam:UntagUser"
      ],
      "Resource": [
        "arn:aws:iam::*:instance-profile/*",
        "arn:aws:iam::*:mfa/*",
        "arn:aws:iam::*:oidc-provider/*",
        "arn:aws:iam::*:policy/*",
        "arn:aws:iam::*:role/apdemo-lambda-exec-dev",
        "arn:aws:iam::*:saml-provider/*",
        "arn:aws:iam::*:server-certificate/*",
        "arn:aws:iam::*:user/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfileTags",
        "iam:ListInstanceProfilesForRole",
        "iam:ListMFADeviceTags",
        "iam:ListOpenIDConnectProviderTags",
        "iam:ListPolicyTags",
        "iam:ListRolePolicies",
        "iam:ListRoleTags",
        "iam:ListSAMLProviderTags",
        "iam:ListServerCertificateTags",
        "iam:ListUserTags",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "arn:aws:iam::*:instance-profile/*",
        "arn:aws:iam::*:mfa/*",
        "arn:aws:iam::*:oidc-provider/*",
        "arn:aws:iam::*:policy/*",
        "arn:aws:iam::*:role/apdemo-lambda-exec-dev",
        "arn:aws:iam::*:saml-provider/*",
        "arn:aws:iam::*:server-certificate/*",
        "arn:aws:iam::*:user/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetLayerVersion",
        "lambda:ListVersionsByFunction",
        "lambda:PassCapacityProvider",
        "lambda:PutFunctionConcurrency"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:*:capacity-provider:*",
        "arn:aws:lambda:ap-northeast-1:*:function:apdemo-api-dev",
        "arn:aws:lambda:ap-northeast-1:*:layer:*:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:DeleteFunction",
        "lambda:GetDurableExecution",
        "lambda:GetFunction",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetLayerVersion",
        "lambda:ListDurableExecutionsByFunction",
        "lambda:ListVersionsByFunction",
        "lambda:PassCapacityProvider",
        "lambda:StopDurableExecution",
        "lambda:UpdateFunctionConfiguration"
      ],
      "Resource": [
        "arn:aws:lambda:ap-northeast-1:*:capacity-provider:*",
        "arn:aws:lambda:ap-northeast-1:*:function:apdemo-api-dev",
        "arn:aws:lambda:ap-northeast-1:*:function:apdemo-api-dev:*/durable-execution/*/*",
        "arn:aws:lambda:ap-northeast-1:*:layer:*:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:ListTags"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3-object-lambda:DeleteObject",
        "s3-object-lambda:GetObjectTagging",
        "s3-object-lambda:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::*/*",
        "arn:aws:s3:ap-northeast-1:*:accesspoint/*/object/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3-object-lambda:DeleteObjectTagging",
        "s3-object-lambda:GetObjectTagging",
        "s3-object-lambda:PutObjectTagging"
      ],
      "Resource": [
        "arn:aws:s3:::*/*",
        "arn:aws:s3:ap-northeast-1:*:accesspoint/*/object/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:BypassGovernanceRetention",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion",
        "s3:GetObjectTagging",
        "s3:GetObjectVersionTagging",
        "s3:PutObjectLegalHold"
      ],
      "Resource": [
        "arn:aws:s3:::apdemo-site-*/*",
        "arn:aws:s3:ap-northeast-1:*:accesspoint/*/object/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:DeleteBucketPolicy",
        "s3:DeleteBucketWebsite",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketPolicy",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:PutAccelerateConfiguration",
        "s3:PutBucketAcl",
        "s3:PutBucketCORS",
        "s3:PutBucketLogging",
        "s3:PutBucketObjectLockConfiguration",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketPolicy",
        "s3:PutBucketRequestPayment",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutBucketWebsite",
        "s3:PutEncryptionConfiguration",
        "s3:PutLifecycleConfiguration",
        "s3:PutReplicationConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::*",
        "arn:aws:s3:ap-northeast-1:*:accesspoint/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketPolicy",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::apdemo-site-*",
        "arn:aws:s3:ap-northeast-1:*:accesspoint/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObjectTagging",
        "s3:DeleteObjectVersionTagging",
        "s3:GetObjectTagging",
        "s3:GetObjectVersionTagging",
        "s3:PutObjectTagging",
        "s3:PutObjectVersionTagging"
      ],
      "Resource": [
        "arn:aws:s3:::*/*",
        "arn:aws:s3:ap-northeast-1:*:accesspoint/*/object/*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3express:GetLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "s3express:GetLifecycleConfiguration",
        "s3express:PutLifecycleConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::*"
      ]
    }
  ]
}
